{
  "name": "add-a-test",
  "prompt": "Add test_max.sh that checks max 3 7 prints 7, and run it.",
  "files": {
    "max.sh": "max() {\n  if [ \"$1\" -gt \"$2\" ]; then echo \"$1\"; else echo \"$2\"; fi\n}\n"
  },
  "script": [
    {
      "calls": [
        [
          "read_file",
          {
            "path": "max.sh"
          }
        ]
      ]
    },
    {
      "calls": [
        [
          "write_file",
          {
            "path": "test_max.sh",
            "content": ". ./max.sh\n[ \"$(max 3 7)\" = 7 ] && echo PASS || { echo FAIL; exit 1; }\n"
          }
        ]
      ]
    },
    {
      "calls": [
        [
          "shell",
          {
            "command": "sh test_max.sh"
          }
        ]
      ]
    },
    {
      "text": "Added test_max.sh; it passes."
    }
  ],
  "expect": {
    "files": {
      "test_max.sh": "max 3 7"
    },
    "unchanged": [
      "max.sh"
    ],
    "command": "sh test_max.sh",
    "answer": [
      "passes"
    ]
  }
}
