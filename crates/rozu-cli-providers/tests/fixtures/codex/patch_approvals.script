> {"method":"item/started","params":{"item":{"type":"fileChange","id":"fc_2","changes":[{"path":".rozu/approvals.json","kind":{"type":"add"},"diff":"+{}\n"}],"status":"inProgress"},"startedAtMs":3,"threadId":"thr_1","turnId":"turn_1"}}
