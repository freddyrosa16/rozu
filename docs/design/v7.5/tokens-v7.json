{
  "$description": "rozu tokens v7 (CURRENT SPEC: v7.5 activity orb pill: a dotted globe per state at two tuned sizes). Layered after tokens-v6.json. Deprecated from v6: bead.*, size.beadDiameter22, motion.morph 480ms, trail, arcBow, and the v5 progress line under the pill. CSS: tokens.css \u2192 tokens-v4.css \u2192 tokens-v5.css \u2192 tokens-v6.css \u2192 tokens-v7.css.",
  "color": {
    "orbDot": {
      "$type": "color",
      "$value": "#F4F1EA",
      "$extensions": {
        "rozu.themes": {
          "dark": "#F4F1EA",
          "light": "#25242A"
        }
      }
    },
    "orbPillBg": {
      "$type": "color",
      "$value": "#1B1B1D",
      "$extensions": {
        "rozu.themes": {
          "dark": "#1B1B1D",
          "light": "#ECECEF"
        }
      }
    },
    "orbPillBorder": {
      "$type": "color",
      "$value": "#2A2A2E",
      "$extensions": {
        "rozu.themes": {
          "dark": "#2A2A2E",
          "light": "#DCDCE0"
        }
      }
    },
    "orbLabel": {
      "$type": "color",
      "$value": "#F4F1EA",
      "$extensions": {
        "rozu.themes": {
          "dark": "#F4F1EA",
          "light": "#25242A"
        }
      }
    },
    "orbMeta": {
      "$type": "color",
      "$value": "#9A9AA2",
      "$extensions": {
        "rozu.themes": {
          "dark": "#9A9AA2",
          "light": "#55555C"
        }
      }
    },
    "orbWarning": {
      "$type": "color",
      "$value": "#FBBF24",
      "$extensions": {
        "rozu.themes": {
          "dark": "#FBBF24",
          "light": "#8A5206"
        }
      }
    },
    "orbSuccess": {
      "$type": "color",
      "$value": "#4ADE80",
      "$extensions": {
        "rozu.themes": {
          "dark": "#4ADE80",
          "light": "#126B33"
        }
      }
    },
    "orbDanger": {
      "$type": "color",
      "$value": "#F87171",
      "$extensions": {
        "rozu.themes": {
          "dark": "#F87171",
          "light": "#B91C1C"
        }
      }
    }
  },
  "orb": {
    "points": {
      "$type": "number",
      "$value": 284,
      "$description": "hard max; the large point set"
    },
    "points22": {
      "$type": "number",
      "$value": 86,
      "$description": "the 22px point set"
    },
    "camera": {
      "$type": "number",
      "$value": 3.2
    },
    "depthAlphaFar": {
      "$type": "number",
      "$value": 0.12
    },
    "depthSizeFar": {
      "$type": "number",
      "$value": 0.4
    },
    "light": {
      "$type": "number",
      "$value": [
        -0.55,
        0.6,
        0.58
      ],
      "$description": "\u03b1\u00d7(.62+.48\u03bb), size\u00d7(.9+.2\u03bb)"
    },
    "dotBase": {
      "$type": "number",
      "$value": 0.011,
      "$description": "\u00d7 orb size"
    },
    "dotBase22": {
      "$type": "number",
      "$value": 0.045
    },
    "litSize": {
      "$type": "number",
      "$value": 1.55
    },
    "litAlpha": {
      "$type": "number",
      "$value": 0.5
    },
    "offlineAlpha": {
      "$type": "number",
      "$value": 0.85
    },
    "snapMaxDevicePx": {
      "$type": "number",
      "$value": 1.6
    },
    "globe": {
      "$type": "number",
      "$value": {
        "radius": 0.9,
        "tilt": 0.3,
        "pageTilt": 0.8,
        "large": { "rings": 15, "lon": 30, "dots": 284, "dotMul": 1, "speedMul": 1 },
        "small": { "rings": 9, "lon": 15, "dots": 86, "dotMul": 1.15, "speedMul": 1.15 }
      },
      "$description": "the dotted globe: lines of latitude, up to `lon` dots round the equator; the 22px size is its own point set"
    }
  },
  "motion": {
    "orbMorph": {
      "$type": "duration",
      "$value": "600ms"
    },
    "orbStagger": {
      "$type": "duration",
      "$value": "300ms",
      "$description": "across the whole cloud: dot i starts hash(i)·300ms late"
    },
    "orbLift": {
      "$type": "number",
      "$value": 0.55
    },
    "orbPulse": {
      "$type": "duration",
      "$value": "150ms"
    },
    "orbPulseLit": {
      "$type": "number",
      "$value": 0.8
    },
    "orbReducedFade": {
      "$type": "duration",
      "$value": "150ms"
    },
    "orbTempo": {
      "thinking": {
        "$type": "duration",
        "$value": "1.6s",
        "$description": "two sparks ripple out, offset by half a period; the globe turns at .35 rad/s"
      },
      "notes": {
        "$type": "duration",
        "$value": "2.6s",
        "$description": "three lines write all the way round the globe over 1.9s, hold, repeat"
      },
      "reading": {
        "$type": "duration",
        "$value": "2.2s",
        "$description": "a band reads down the globe"
      },
      "searching": {
        "$type": "duration",
        "$value": "2.4s",
        "$description": "a lens roams the surface"
      },
      "editing": {
        "$type": "duration",
        "$value": "2.4s",
        "$description": "a caret laps one full line of the page every 2.4s, revising the dots behind it"
      },
      "running": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "a helical stripe; the globe spins at 2.4 rad/s"
      },
      "waiting": {
        "$type": "duration",
        "$value": "1.8s",
        "$description": "the globe breathes ±3%"
      },
      "doneDraw": {
        "$type": "duration",
        "$value": "450ms",
        "$description": "check stroke, from 250ms, then a 250ms pop"
      },
      "errorShake": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "damped shake, from 300ms"
      },
      "offline": {
        "$type": "duration",
        "$value": "2.4s",
        "$description": "rings drop out in 400ms slots"
      },
      "settle": {
        "$type": "duration",
        "$value": "1.3s"
      }
    }
  },
  "size": {
    "orb": {
      "$type": "dimension",
      "$value": "22px"
    },
    "orbLg": {
      "$type": "dimension",
      "$value": "88px"
    },
    "activityPill": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "34px in the dock"
    }
  }
}
